{
  "schema": 1,
  "items": [
    {"id": "no.ff.tegami", "surface": "手紙", "vocab": "vo.tegami", "ja_zh": "信（書信）", "misread_zh": "看字面以為是衛生紙", "lesson": "le.l12"},
    {"id": "no.ff.daijoubu", "surface": "大丈夫", "vocab": "vo.daijoubu", "ja_zh": "沒問題、沒事、不要緊", "misread_zh": "以為是「男子漢大丈夫」的大丈夫", "lesson": "le.l09"},
    {"id": "no.ff.benkyou", "surface": "勉強", "vocab": "vo.benkyou", "ja_zh": "念書、學習", "misread_zh": "以為是「勉強」，也就是不情願、硬撐著做", "lesson": "le.l05"},
    {"id": "no.ff.aijin", "surface": "愛人", "vocab": null, "ja_zh": "{ja:愛人|あいじん}：情婦、情夫（婚外的戀人）", "misread_zh": "以為是配偶或心愛的另一半", "lesson": null},
    {"id": "no.ff.kisha", "surface": "汽車", "vocab": null, "ja_zh": "{ja:汽車|きしゃ}：火車（較舊的說法，原指蒸汽火車）", "misread_zh": "以為是汽車（轎車）；轎車在日文是「{ja:車|くるま}」或「{ja:自動車|じどうしゃ}」", "lesson": null},
    {"id": "no.ff.musume", "surface": "娘", "vocab": null, "ja_zh": "{ja:娘|むすめ}：女兒（也指年輕女孩）", "misread_zh": "以為是「爹娘」的娘，也就是媽媽", "lesson": null},
    {"id": "no.ff.joubu", "surface": "丈夫", "vocab": "vo.joubu", "ja_zh": "堅固耐用；身體健壯", "misread_zh": "以為是「老公」", "lesson": "le.l25"},
    {"id": "no.ff.shinbun", "surface": "新聞", "vocab": "vo.shinbun", "ja_zh": "報紙", "misread_zh": "以為是電視上的新聞；新聞報導在日文是「{ja:ニュース}」", "lesson": "le.l02"},
    {"id": "no.ff.rusu", "surface": "留守", "vocab": null, "ja_zh": "{ja:留守|るす}：不在家、外出不在", "misread_zh": "以為是「留守」，也就是留下來看守；留下來看家在日文是「{ja:留守番|るすばん}」", "lesson": null},
    {"id": "no.ff.yuka", "surface": "床", "vocab": null, "ja_zh": "{ja:床|ゆか}：地板", "misread_zh": "以為是睡覺的床；一般說床是「{ja:ベッド}」。這個字讀 {ja:とこ} 時才指床鋪、被褥（如 {ja:床に就く|とこにつく}＝就寢），比較書面", "lesson": null},
    {"id": "no.ff.hashiru", "surface": "走る", "vocab": "vo.hashiru", "ja_zh": "跑、奔跑", "misread_zh": "以為是「走路」；走路在日文是「{ja:歩く|あるく}」", "lesson": "le.l14"},
    {"id": "no.ff.ninjin", "surface": "人参", "vocab": null, "ja_zh": "{ja:人参|にんじん}：紅蘿蔔", "misread_zh": "以為是人參（高麗參）；人參在日文是「{ja:高麗人参|こうらいにんじん}」或「{ja:朝鮮人参|ちょうせんにんじん}」", "lesson": null},
    {"id": "no.ff.yu", "surface": "湯", "vocab": null, "ja_zh": "{ja:湯|ゆ}：熱水（也指澡堂、溫泉的熱水）", "misread_zh": "以為是喝的湯；喝的湯在日文是「{ja:スープ}」或「{ja:汁|しる}」", "lesson": null},
    {"id": "no.ff.hiniku", "surface": "皮肉", "vocab": null, "ja_zh": "{ja:皮肉|ひにく}：諷刺、挖苦", "misread_zh": "以為是皮和肉，或是皮肉傷", "lesson": null},
    {"id": "no.ff.meiwaku", "surface": "迷惑", "vocab": null, "ja_zh": "{ja:迷惑|めいわく}：麻煩、困擾（給人添麻煩）", "misread_zh": "以為是「迷惑」，也就是困惑不解或被誘騙", "lesson": null},
    {"id": "no.ff.shitsumon", "surface": "質問", "vocab": "vo.shitsumon", "ja_zh": "提問、發問", "misread_zh": "以為是「質問」，也就是帶著責備口氣追問、責問", "lesson": "le.l18"},
    {"id": "no.ff.kanai", "surface": "家内", "vocab": null, "ja_zh": "{ja:家内|かない}：內人（向別人稱自己的太太）", "misread_zh": "以為是「家裡面」；只有在 {ja:家内安全|かないあんぜん}（全家平安）這類詞裡才是「家裡、家人」的意思", "lesson": null},
    {"id": "no.ff.gaman", "surface": "我慢", "vocab": null, "ja_zh": "{ja:我慢|がまん}：忍耐、忍住", "misread_zh": "看字面以為是「我很慢」", "lesson": null},
    {"id": "no.ff.yakusoku", "surface": "約束", "vocab": null, "ja_zh": "{ja:約束|やくそく}：約定、承諾", "misread_zh": "以為是「約束」，也就是限制、管束", "lesson": null},
    {"id": "no.ff.bengi", "surface": "便宜", "vocab": null, "ja_zh": "{ja:便宜|べんぎ}：方便、權宜", "misread_zh": "以為是價錢低的便宜；價錢便宜在日文是「{ja:安い|やすい}」", "lesson": null},
    {"id": "no.ff.yasui", "surface": "安い", "vocab": "vo.yasui", "ja_zh": "便宜（價錢低）", "misread_zh": "看到「安」，以為是安全、安穩", "lesson": "le.l09"},
    {"id": "no.ff.kitte", "surface": "切手", "vocab": "vo.kitte", "ja_zh": "郵票", "misread_zh": "看字面以為是剁手、切斷手", "lesson": "le.l24"},
    {"id": "no.ff.jouzu", "surface": "上手", "vocab": "vo.jouzu", "ja_zh": "擅長、很厲害（多半用來稱讚別人）", "misread_zh": "以為是「很好上手」的上手，也就是剛學會、容易學", "lesson": "le.l10"},
    {"id": "no.ff.heta", "surface": "下手", "vocab": "vo.heta", "ja_zh": "不擅長、笨拙", "misread_zh": "以為是「從哪裡下手」的下手，也就是動手、著手", "lesson": "le.l10"},
    {"id": "no.ff.kufuu", "surface": "工夫", "vocab": null, "ja_zh": "{ja:工夫|くふう}：想辦法、花巧思", "misread_zh": "以為是空閒時間（例如「沒工夫」），或是武術的功夫", "lesson": null},
    {"id": "no.ff.kessoku", "surface": "結束", "vocab": null, "ja_zh": "{ja:結束|けっそく}：團結", "misread_zh": "以為是「結束」，也就是完畢；結束在日文是「{ja:終わる|おわる}」", "lesson": null},
    {"id": "no.ff.houshin", "surface": "放心", "vocab": null, "ja_zh": "{ja:放心|ほうしん}：發呆、茫然失神", "misread_zh": "以為是「放心」，也就是安心；放心在日文是「{ja:安心|あんしん}」", "lesson": null},
    {"id": "no.ff.majime", "surface": "真面目", "vocab": null, "ja_zh": "{ja:真面目|まじめ}：認真、正經", "misread_zh": "以為是「真面目」，也就是本來面目、真實樣貌；這個詞讀 {ja:しんめんもく} 時才是這個意思，比較書面", "lesson": null},
    {"id": "no.ff.ichininmae", "surface": "一人前", "vocab": null, "ja_zh": "{ja:一人前|いちにんまえ}：獨當一面、能自立（也指一人份）", "misread_zh": "看字面以為是「一個人的面前」", "lesson": null},
    {"id": "no.ff.ooya", "surface": "大家", "vocab": null, "ja_zh": "{ja:大家|おおや}：房東", "misread_zh": "以為是「大家」，也就是所有人；大家在日文是「{ja:皆さん|みなさん}」", "lesson": null},
    {"id": "no.ff.omoshiroi", "surface": "面白い", "vocab": "vo.omoshiroi", "ja_zh": "有趣、好玩", "misread_zh": "看字面以為是臉色發白", "lesson": "le.l10"},
    {"id": "no.ff.kega", "surface": "怪我", "vocab": "vo.kega", "ja_zh": "受傷", "misread_zh": "以為是「怪我」，也就是怪罪我、責怪我", "lesson": "le.l25"},
    {"id": "no.ff.hisshi", "surface": "必死", "vocab": null, "ja_zh": "{ja:必死|ひっし}：拚命、全力以赴", "misread_zh": "以為是「必死無疑」", "lesson": null},
    {"id": "no.ff.kokuso", "surface": "告訴", "vocab": null, "ja_zh": "{ja:告訴|こくそ}：提告（法律用語）", "misread_zh": "以為是「告訴」，也就是跟別人說；告訴在日文是「{ja:言う|いう}」或「{ja:教える|おしえる}」", "lesson": null},
    {"id": "no.ff.kentou", "surface": "検討", "vocab": null, "ja_zh": "{ja:検討|けんとう}：研究考慮、評估", "misread_zh": "以為是「檢討」，也就是反省錯誤、追究責任", "lesson": null},
    {"id": "no.ff.anzan", "surface": "暗算", "vocab": null, "ja_zh": "{ja:暗算|あんざん}：心算（不用紙筆計算）", "misread_zh": "以為是「暗算」，也就是暗中陷害", "lesson": null},
    {"id": "no.ff.sensei", "surface": "先生", "vocab": "vo.sensei", "ja_zh": "老師（也用來尊稱醫師、律師等）", "misread_zh": "以為是稱呼男士或丈夫的「先生」", "lesson": "le.l01"},
    {"id": "no.ff.goudou", "surface": "合同", "vocab": null, "ja_zh": "{ja:合同|ごうどう}：聯合、合辦", "misread_zh": "以為是「合同」，也就是合約、契約", "lesson": null},
    {"id": "no.ff.kaji", "surface": "火事", "vocab": null, "ja_zh": "{ja:火事|かじ}：火災", "misread_zh": "看字面以為是跟火有關的事情，想不到就是失火", "lesson": null},
    {"id": "no.ff.jimi", "surface": "地味", "vocab": null, "ja_zh": "{ja:地味|じみ}：樸素、不起眼", "misread_zh": "以為是土地的味道或鄉土味", "lesson": null},
    {"id": "no.ff.hade", "surface": "派手", "vocab": null, "ja_zh": "{ja:派手|はで}：花俏、華麗搶眼", "misread_zh": "看字面以為是派出人手", "lesson": null},
    {"id": "no.ff.annai", "surface": "案内", "vocab": null, "ja_zh": "{ja:案内|あんない}：導覽、帶路、介紹", "misread_zh": "看字面以為是案件的內容", "lesson": null},
    {"id": "no.ff.muri", "surface": "無理", "vocab": "vo.muri", "ja_zh": "辦不到、不可能；也指勉強硬撐", "misread_zh": "以為是「無理取鬧」的無理；日常說「{ja:無理|むり}」多半是辦不到", "lesson": "le.l18"},
    {"id": "no.ff.genki", "surface": "元気", "vocab": "vo.genki", "ja_zh": "有精神、身體好（{ja:お元気ですか|おげんきですか}＝你好嗎）", "misread_zh": "看成「元氣」，以為是在問還有沒有體力，想不到是一般的問候", "lesson": "le.l09"},
    {"id": "no.ff.kimochi", "surface": "気持ち", "vocab": null, "ja_zh": "{ja:気持ち|きもち}：心情、感受（{ja:気持ちいい|きもちいい}＝很舒服）", "misread_zh": "看字面以為和脾氣、力氣有關", "lesson": null},
    {"id": "no.ff.bangumi", "surface": "番組", "vocab": null, "ja_zh": "{ja:番組|ばんぐみ}：電視、廣播的節目", "misread_zh": "看字面以為是輪班的組別", "lesson": null},
    {"id": "no.ff.rouba", "surface": "老婆", "vocab": null, "ja_zh": "{ja:老婆|ろうば}：老太太、老婦人", "misread_zh": "以為是「老婆」，也就是太太", "lesson": null},
    {"id": "no.ff.hanten", "surface": "飯店", "vocab": null, "ja_zh": "{ja:飯店|はんてん}：中式餐館（常見於中華料理店的店名）", "misread_zh": "以為是「飯店」，也就是旅館；飯店在日文是「{ja:ホテル}」", "lesson": null},
    {"id": "no.ff.jidousha", "surface": "自動車", "vocab": "vo.jidousha", "ja_zh": "汽車（轎車、卡車等）", "misread_zh": "以為是自動駕駛的車或自排車", "lesson": "le.l26"},
    {"id": "no.ff.jitensha", "surface": "自転車", "vocab": "vo.jitensha", "ja_zh": "腳踏車", "misread_zh": "看字面以為是會自己轉動的車", "lesson": "le.l06"},
    {"id": "no.ff.densha", "surface": "電車", "vocab": "vo.densha", "ja_zh": "電車、列車（用電行駛的火車、捷運、地鐵）", "misread_zh": "以為是台灣口語的「電車」，也就是電動機車", "lesson": "le.l06"},
    {"id": "no.ff.tokei", "surface": "時計", "vocab": "vo.tokei", "ja_zh": "時鐘、手錶", "misread_zh": "看成「計時」或「時間計畫」，想不到就是時鐘、手錶", "lesson": "le.l02"},
    {"id": "no.ff.eiga", "surface": "映画", "vocab": "vo.eiga", "ja_zh": "電影", "misread_zh": "看字面以為是投影出來的圖畫", "lesson": "le.l07"},
    {"id": "no.ff.shinsetsu", "surface": "親切", "vocab": "vo.shinsetsu", "ja_zh": "好心、熱心幫忙", "misread_zh": "用法近似；但中文「覺得很親切」是熟悉、親近的感覺，日文沒有這個用法", "lesson": "le.l17"},
    {"id": "no.ff.kekkou", "surface": "結構", "vocab": "vo.kekkou", "ja_zh": "相當、很好；也用來婉拒「不用了」", "misread_zh": "以為是「結構」，也就是構造、架構（日常口語幾乎不這樣用）", "lesson": "le.l29"},
    {"id": "no.ff.kaidan", "surface": "階段", "vocab": "vo.kaidan", "ja_zh": "樓梯", "misread_zh": "以為是「階段」，也就是時期、步驟（例如第一階段）", "lesson": "le.l30"},
    {"id": "no.ff.yasai", "surface": "野菜", "vocab": "vo.yasai", "ja_zh": "蔬菜（所有青菜）", "misread_zh": "以為是山上野生的菜", "lesson": "le.l07"},
    {"id": "no.ff.tsukue", "surface": "机", "vocab": "vo.tsukue", "ja_zh": "書桌", "misread_zh": "看成「機」的簡體字，以為是機器", "lesson": "le.l08"},
    {"id": "no.ff.taihen", "surface": "大変", "vocab": "vo.taihen", "ja_zh": "辛苦、糟糕、嚴重（也當副詞「非常」）", "misread_zh": "看成「大變」，以為是發生巨大的變化", "lesson": "le.l22"},
    {"id": "no.ff.jama", "surface": "邪魔", "vocab": null, "ja_zh": "{ja:邪魔|じゃま}：打擾、妨礙（{ja:お邪魔します|おじゃまします}＝打擾了）", "misread_zh": "以為是邪惡的魔鬼", "lesson": null}
  ]
}
