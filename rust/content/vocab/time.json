  {"id": "vo.atode", "lesson": "le.l16", "lesson_order": 9, "surface": "後で", "kana": "あとで", "zh": ["待會兒", "等一下"], "pos": "adv", "accent": null, "jlpt": "beyond", "topics": ["time", "adverb"], "examples": ["se.l16.012", "se.l16.024", "se.l19.028"], "trap_zh": "{ja:後で|あとで} 是時間上的「待會兒」；位置的「後面」說 {ja:後ろ|うしろ}。", "notes": []},
