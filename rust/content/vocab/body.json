  {"id": "vo.koe", "lesson": "le.l16", "lesson_order": 11, "surface": "声", "kana": "こえ", "zh": ["（人或動物的）聲音", "嗓音"], "pos": "n", "accent": null, "jlpt": "n5", "topics": ["body"], "examples": ["se.l16.016", "se.l16.026", "se.l18.028"], "trap_zh": "只用於人或動物；物品發出的聲音是 {ja:音|おと}。", "notes": ["no.sj.sei_voice"]},
