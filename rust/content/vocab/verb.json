  {"id": "vo.aru", "lesson": "le.l08", "lesson_order": 1, "surface": "ある", "kana": "ある", "zh": ["有（物品）", "在（物品）"], "pos": "v5", "trans": "in", "accent": null, "jlpt": "n5", "topics": ["verb"], "examples": ["se.l08.001", "se.l08.002", "se.l08.005", "se.l08.006"], "trap_zh": "表示物品、植物的存在；人和動物要用 {ja:いる}。", "notes": ["no.tr.aru_iru"], "conj_omit": ["potential", "passive", "causative"]},
  {"id": "vo.iru", "lesson": "le.l08", "lesson_order": 2, "surface": "いる", "kana": "いる", "zh": ["有（人、動物）", "在（人、動物）"], "pos": "v1", "trans": "in", "accent": null, "jlpt": "n5", "topics": ["verb"], "examples": ["se.l08.003", "se.l08.008", "se.l08.009", "se.l08.010"], "trap_zh": "表示人或動物的存在；物品要用 {ja:ある}。", "notes": ["no.tr.aru_iru"]},
  {"id": "vo.wakaru", "lesson": "le.l10", "lesson_order": 6, "surface": "分かる", "kana": "わかる", "zh": ["懂", "知道", "了解"], "pos": "v5", "trans": "in", "accent": null, "jlpt": "n5", "topics": ["verb"], "examples": ["se.l10.013", "se.l10.021", "se.l10.022", "se.l10.027"], "trap_zh": "懂的內容用 {ja:が}，不用 {ja:を}：{ja:日本語が分かります|にほんごがわかります}。", "notes": [], "conj_omit": ["potential", "passive", "imperative"]},
  {"id": "vo.utau", "lesson": "le.l10", "lesson_order": 9, "surface": "歌う", "kana": "うたう", "zh": ["唱歌", "唱"], "pos": "v5", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb", "hobby"], "examples": ["se.l10.018", "se.l10.019", "se.l12.011"], "notes": []},
