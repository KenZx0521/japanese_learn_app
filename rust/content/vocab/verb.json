  {"id": "vo.oshieru", "lesson": "le.l14", "lesson_order": 18, "surface": "教える", "kana": "おしえる", "zh": ["教", "告訴"], "pos": "v1", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb", "school"], "examples": ["se.l14.037", "se.l15.052", "se.l16.021"], "trap_zh": "除了「教」，把資訊告訴別人也用這個字。", "notes": []},
  {"id": "vo.narau", "lesson": "le.l14", "lesson_order": 19, "surface": "習う", "kana": "ならう", "zh": ["學習（向人學）"], "pos": "v5", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb", "school"], "examples": ["se.l14.015", "se.l14.058", "se.l16.058", "se.l17.037"], "trap_zh": "指向老師學技能；自己念書是 {ja:勉強|べんきょう}。", "notes": []},
