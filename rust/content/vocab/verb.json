  {"id": "vo.migaku", "lesson": "le.l17", "lesson_order": 19, "surface": "磨く", "kana": "みがく", "zh": ["刷（牙）", "擦亮"], "pos": "v5", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb", "home"], "examples": ["se.l17.034", "se.l17.035"], "notes": []},
  {"id": "vo.kaesu", "lesson": "le.l18", "lesson_order": 1, "surface": "返す", "kana": "かえす", "zh": ["歸還", "還"], "pos": "v5", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb"], "examples": ["se.l18.006", "se.l18.007"], "trap_zh": "還東西用 {ja:返す|かえす}；回家是 {ja:帰る|かえる}，兩者容易搞混。", "notes": ["no.sj.hen_return"]},
