  {"id": "vo.mitsukeru", "lesson": "le.l23", "lesson_order": 6, "surface": "見つける", "kana": "みつける", "zh": ["找到", "發現"], "pos": "v1", "trans": "tr", "pair": "vo.mitsukaru", "accent": null, "jlpt": "n4", "topics": ["verb"], "examples": ["se.l23.012", "se.l23.013", "se.l23.040", "se.l23.043"], "trap_zh": "以找的人為主語，東西用 {ja:を}：{ja:財布を見つけました|さいふをみつけました}。", "notes": []},
  {"id": "vo.dekiru", "lesson": "le.l24", "lesson_order": 1, "surface": "できる", "kana": "できる", "zh": ["會", "能夠", "完成"], "pos": "v1", "trans": "in", "accent": null, "jlpt": "n5", "topics": ["verb"], "examples": ["se.l24.001", "se.l24.032", "se.l24.067", "se.l24.018"], "trap_zh": "會的事情用 {ja:が}：{ja:日本語ができます|にほんごができます}，不是 {ja:を}。", "notes": ["no.tr.hui"], "conj_omit": ["potential", "passive", "causative", "imperative"]},
