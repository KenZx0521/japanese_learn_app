  {"id": "vo.nugu", "lesson": "le.l19", "lesson_order": 5, "surface": "脱ぐ", "kana": "ぬぐ", "zh": ["脫（衣服、鞋）"], "pos": "v5", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb", "shop"], "examples": ["se.l19.008", "se.l19.036"], "notes": ["no.sj.datsu"]},
  {"id": "vo.aku", "lesson": "le.l19", "lesson_order": 16, "surface": "開く", "kana": "あく", "zh": ["開（門、店）"], "pos": "v5", "trans": "in", "pair": "vo.akeru", "accent": null, "jlpt": "n5", "topics": ["verb"], "examples": ["se.l19.046", "se.l19.047"], "trap_zh": "沒有受詞，主語是門或店：{ja:ドアが開く|ドアがあく}。要把門打開用 {ja:開ける|あける}。", "notes": [], "conj_omit": ["potential", "passive", "causative"]},
  {"id": "vo.shimaru", "lesson": "le.l19", "lesson_order": 17, "surface": "閉まる", "kana": "しまる", "zh": ["關閉（門、店）"], "pos": "v5", "trans": "in", "pair": "vo.shimeru", "accent": null, "jlpt": "n5", "topics": ["verb"], "examples": ["se.l19.048", "se.l19.049"], "trap_zh": "沒有受詞，主語是門或店：{ja:店が閉まる|みせがしまる}。要把門關上用 {ja:閉める|しめる}。", "notes": [], "conj_omit": ["potential", "passive", "causative"]},
  {"id": "vo.tomaru_stay", "lesson": "le.l19", "lesson_order": 19, "surface": "泊まる", "kana": "とまる", "zh": ["住宿", "過夜"], "pos": "v5", "trans": "in", "accent": null, "jlpt": "n4", "topics": ["verb", "travel"], "examples": ["se.l19.050", "se.l19.052"], "trap_zh": "住宿的地方用 {ja:に}：{ja:ホテルに泊まる|ホテルにとまる}。和 {ja:止まる|とまる}（停止）同音。", "notes": []},
  {"id": "vo.haru_stick", "lesson": "le.l19", "lesson_order": 20, "surface": "貼る", "kana": "はる", "zh": ["貼"], "pos": "v5", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb"], "examples": ["se.l19.015", "se.l19.053"], "notes": []},
  {"id": "vo.noboru", "lesson": "le.l20", "lesson_order": 20, "surface": "登る", "kana": "のぼる", "zh": ["爬（山）", "登上"], "pos": "v5", "trans": "in", "accent": null, "jlpt": "n5", "topics": ["verb", "hobby"], "examples": ["se.l20.023", "se.l20.025", "se.l20.026", "se.l30.047"], "trap_zh": "爬的地方用 {ja:に}：{ja:山に登る|やまにのぼる}。", "notes": []},
  {"id": "vo.odoru", "lesson": "le.l20", "lesson_order": 21, "surface": "踊る", "kana": "おどる", "zh": ["跳舞"], "pos": "v5", "trans": "in", "accent": null, "jlpt": "n4", "topics": ["verb", "hobby"], "examples": ["se.l20.011", "se.l20.043", "se.l23.065"], "notes": []},
