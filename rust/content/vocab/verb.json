  {"id": "vo.okureru", "lesson": "le.l18", "lesson_order": 24, "surface": "遅れる", "kana": "おくれる", "zh": ["遲到", "誤點", "來不及"], "pos": "v1", "trans": "in", "accent": null, "jlpt": "n4", "topics": ["verb", "time"], "examples": ["se.l18.025", "se.l19.017"], "trap_zh": "遲到的對象用 {ja:に}：{ja:授業に遅れる|じゅぎょうにおくれる}。", "notes": ["no.sj.chi"]},
  {"id": "vo.tsukeru", "lesson": "le.l18", "lesson_order": 27, "surface": "つける", "kana": "つける", "zh": ["開（電燈、電視）", "點亮"], "pos": "v1", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb", "home"], "examples": ["se.l18.049", "se.l18.050"], "notes": ["no.tr.kai_light"]},
