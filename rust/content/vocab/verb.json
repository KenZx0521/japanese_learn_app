  {"id": "vo.mayou", "lesson": "le.l21", "lesson_order": 30, "surface": "迷う", "kana": "まよう", "zh": ["迷路", "猶豫"], "pos": "v5", "trans": "in", "accent": null, "jlpt": "beyond", "topics": ["verb"], "examples": ["se.l21.038", "se.l22.057", "se.l29.009"], "trap_zh": "迷路是 {ja:道に迷う|みちにまよう}，也有「猶豫不決」的意思。", "notes": []},
