  {"id": "vo.sawaru", "lesson": "le.l18", "lesson_order": 6, "surface": "触る", "kana": "さわる", "zh": ["碰", "摸"], "pos": "v5", "trans": "in", "accent": null, "jlpt": "n4", "topics": ["verb"], "examples": ["se.l18.010", "se.l18.011", "se.l19.012", "se.l19.023"], "trap_zh": "碰觸的對象用 {ja:に}：{ja:絵に触らないでください|えにさわらないでください}。", "notes": ["no.sj.shoku"]},
  {"id": "vo.oku", "lesson": "le.l18", "lesson_order": 7, "surface": "置く", "kana": "おく", "zh": ["放置"], "pos": "v5", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb"], "examples": ["se.l18.014", "se.l18.013"], "notes": []},
  {"id": "vo.toru_photo", "lesson": "le.l18", "lesson_order": 8, "surface": "撮る", "kana": "とる", "zh": ["拍（照）", "攝影"], "pos": "v5", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb", "hobby"], "examples": ["se.l18.016", "se.l18.015", "se.l19.001", "se.l19.002"], "trap_zh": "和 {ja:取る|とる}（拿）同音，拍照只寫 {ja:撮る|とる}。", "notes": []},
  {"id": "vo.toru", "lesson": "le.l18", "lesson_order": 9, "surface": "取る", "kana": "とる", "zh": ["拿", "取", "摘（花）", "訂（座位）"], "pos": "v5", "trans": "tr", "accent": null, "jlpt": "n5", "topics": ["verb"], "examples": ["se.l18.017", "se.l18.018", "se.l19.013", "se.l19.059"], "trap_zh": "和 {ja:撮る|とる}（拍照）同音。", "notes": []},
