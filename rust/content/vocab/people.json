  {"id": "vo.gaikokujin", "lesson": "le.l24", "lesson_order": 15, "surface": "外国人", "kana": "がいこくじん", "zh": ["外國人"], "pos": "n", "accent": null, "jlpt": "n5", "topics": ["people"], "same_form_zh": true, "examples": ["se.l24.036", "se.l24.037", "se.l24.051", "se.l27.061"], "trap_zh": "當面稱呼時，{ja:外国の方|がいこくのかた} 較客氣。", "notes": ["no.sj.koku_country"]},
