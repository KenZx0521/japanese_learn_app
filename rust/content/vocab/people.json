  {"id": "vo.watashi", "lesson": "le.l01", "lesson_order": 3, "surface": "私", "kana": "わたし", "zh": ["我"], "pos": "pron", "accent": null, "jlpt": "n5", "topics": ["people"], "examples": ["se.l01.005", "se.l01.006", "se.l01.015"], "trap_zh": "主語明確時通常省略，不要句句都說 {ja:私|わたし}。", "notes": []},
