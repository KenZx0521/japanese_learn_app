  {"id": "vo.obaasan", "lesson": "le.l28", "lesson_order": 15, "surface": "おばあさん", "kana": "おばあさん", "zh": ["奶奶", "老奶奶"], "pos": "n", "accent": null, "jlpt": "n5", "topics": ["people"], "examples": ["se.l28.010", "se.l28.013", "se.l30.005"], "trap_zh": "{ja:あ} 要拉長，少了長音就變成 {ja:おばさん}（阿姨、伯母）。", "notes": []},
  {"id": "vo.ojisan", "lesson": "le.l28", "lesson_order": 16, "surface": "おじさん", "kana": "おじさん", "zh": ["叔叔", "伯伯", "中年男子"], "pos": "n", "accent": null, "jlpt": "n5", "topics": ["people"], "examples": ["se.l28.061", "se.l28.025"], "hook_zh": "台灣說的「歐吉桑」就來自這個字。", "notes": []},
