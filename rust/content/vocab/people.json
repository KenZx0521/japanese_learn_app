  {"id": "vo.oneesan", "lesson": "le.l28", "lesson_order": 19, "surface": "お姉さん", "kana": "おねえさん", "zh": ["姊姊（尊稱）"], "pos": "n", "accent": null, "jlpt": "n5", "topics": ["people"], "examples": ["se.l28.052", "se.l28.053", "se.l29.045"], "trap_zh": "對外稱自己的姊姊用 {ja:姉|あね}。", "notes": ["no.sj.shi_sister"]},
  {"id": "vo.okusan", "lesson": "le.l28", "lesson_order": 20, "surface": "奥さん", "kana": "おくさん", "zh": ["太太（稱別人的）"], "pos": "n", "accent": null, "jlpt": "n5", "topics": ["people"], "examples": ["se.l28.040", "se.l28.054", "se.l29.037"], "trap_zh": "只能稱別人的太太；自己的太太說 {ja:妻|つま}。", "notes": ["no.sj.ou_inner"]},
