  {"id": "vo.hito", "lesson": "le.l01", "lesson_order": 16, "surface": "人", "kana": "ひと", "zh": ["人"], "pos": "n", "accent": null, "jlpt": "n5", "topics": ["people"], "same_form_zh": true, "examples": ["se.l01.025", "se.l01.026", "se.l01.034"], "reading_family": ["vo.nihonjin", "vo.taiwanjin"], "notes": ["no.rd.intro"]},
  {"id": "vo.anata", "lesson": "le.l01", "lesson_order": 17, "surface": "あなた", "kana": "あなた", "zh": ["你"], "pos": "pron", "accent": null, "jlpt": "n5", "topics": ["people"], "examples": ["se.l01.027", "se.l01.028"], "trap_zh": "對長輩、老師或不熟的人別說 {ja:あなた}，知道姓氏就用「姓氏＋{ja:さん}」。", "notes": ["no.tr.anata"]},
  {"id": "vo.kazoku", "lesson": "le.l06", "lesson_order": 11, "surface": "家族", "kana": "かぞく", "zh": ["家人"], "pos": "n", "accent": null, "jlpt": "n5", "topics": ["people"], "same_form_zh": true, "examples": ["se.l06.018", "se.l06.034"], "reading_family": ["vo.ie"], "notes": ["no.rd.ru_k"]},
  {"id": "vo.otousan", "lesson": "le.l06", "lesson_order": 12, "surface": "お父さん", "kana": "おとうさん", "zh": ["爸爸", "令尊"], "pos": "n", "accent": null, "jlpt": "n5", "topics": ["people"], "examples": ["se.l06.036", "se.l06.037"], "trap_zh": "當面叫自己的爸爸、或稱呼別人的爸爸都用 {ja:お父さん|おとうさん}；向外人提到自己的爸爸用 {ja:父|ちち}。", "notes": []},
  {"id": "vo.okaasan", "lesson": "le.l06", "lesson_order": 13, "surface": "お母さん", "kana": "おかあさん", "zh": ["媽媽", "令堂"], "pos": "n", "accent": null, "jlpt": "n5", "topics": ["people"], "examples": ["se.l06.036", "se.l06.038"], "trap_zh": "當面叫自己的媽媽、或稱呼別人的媽媽都用 {ja:お母さん|おかあさん}；向外人提到自己的媽媽用 {ja:母|はは}。", "notes": []},
