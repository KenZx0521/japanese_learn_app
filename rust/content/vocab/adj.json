  {"id": "vo.onaji", "lesson": "le.l13", "lesson_order": 2, "surface": "同じ", "kana": "おなじ", "zh": ["相同", "一樣"], "pos": "phrase", "accent": null, "jlpt": "n5", "topics": ["adj"], "examples": ["se.l13.028", "se.l13.030", "se.l13.031", "se.l13.032"], "trap_zh": "接名詞時什麼都不加：{ja:同じ本|おなじほん}，不說 {ja:同じの本|おなじのほん}。", "notes": []},
