  {"id": "dr.l03.par.001", "type": "particle_fill", "lesson": "le.l03", "targets": ["gr.ikura", "gr.wa_topic"], "sentence": "se.l03.006", "blanks": [{"word_index": 1, "choices": ["は|gr.wa_topic", "も|gr.mo_also", "の|gr.no_poss", "か|gr.ka_q"]}], "explain_zh": "問價錢時，東西當主題要接 {ja:は}。"},
  {"id": "dr.l03.par.002", "type": "particle_fill", "lesson": "le.l03", "targets": ["gr.n_kudasai"], "sentence": "se.l03.012", "blanks": [{"word_index": 1, "choices": ["を|gr.n_kudasai", "は|gr.wa_topic", "の|gr.no_poss", "か|gr.ka_q"]}], "explain_zh": "{ja:をください} 是一整塊，要的東西放前面，接 {ja:を}。"},
  {"id": "dr.l03.par.003", "type": "particle_fill", "lesson": "le.l03", "targets": ["gr.onegai"], "sentence": "se.l03.020", "blanks": [{"word_index": 1, "choices": ["を|gr.onegai", "は|gr.wa_topic", "も|gr.mo_also", "の|gr.no_poss"]}], "explain_zh": "{ja:をお願いします|をおねがいします} 是一整塊，東西放前面，接 {ja:を}。"},
  {"id": "dr.l03.par.004", "type": "particle_fill", "lesson": "le.l03", "targets": ["gr.no_pron_own"], "sentence": "se.l03.042", "blanks": [{"word_index": 3, "choices": ["の|gr.no_pron_own", "は|gr.wa_topic", "を|gr.n_kudasai", "か|gr.ka_q"]}], "explain_zh": "「我的」要用 {ja:私の|わたしの}；省略名詞時 {ja:の} 不能丟。"},
  {"id": "dr.l03.z2j.001", "type": "zh_to_ja_choice", "lesson": "le.l03", "targets": ["gr.numbers"], "prompt_zh": "300 日圓（選出正確的讀音）。", "answer": "さんびゃくえん|gr.numbers です|gr.desu 。", "distractors": [{"t": "さんひゃくえん|gr.numbers です|gr.desu 。", "why_zh": "300 的「百」要變音，讀 {ja:びゃく}，不是 {ja:ひゃく}。"}, {"t": "さんぴゃくえん|gr.numbers です|gr.desu 。", "why_zh": "{ja:ぴゃく} 是 600、800 才有的變音，300 要讀 {ja:びゃく}。"}]},
  {"id": "dr.l03.z2j.002", "type": "zh_to_ja_choice", "lesson": "le.l03", "targets": ["gr.ikura"], "prompt_zh": "這個多少錢？", "answer": "se.l03.006", "distractors": [{"t": "これ|vo.kore は|gr.wa_topic いくら|vo.ikura お金|おかね|vo.okane です|gr.desu か|gr.ka_q 。", "why_zh": "{ja:いくら} 本身就是「多少錢」，不必再加 {ja:お金|おかね}。"}, {"t": "いくら|vo.ikura は|gr.wa_topic これ|vo.kore です|gr.desu か|gr.ka_q 。", "why_zh": "主題要放前面：{ja:これは} 再接 {ja:いくらですか}。"}]},
  {"id": "dr.l03.z2j.003", "type": "zh_to_ja_choice", "lesson": "le.l03", "targets": ["gr.n_kudasai"], "prompt_zh": "請給我水。", "answer": "se.l03.012", "distractors": [{"t": "ください|gr.n_kudasai 水|みず|vo.mizu を|gr.n_kudasai 。", "why_zh": "中文「請給我」在前面，日文 {ja:ください} 要放在最後。"}, {"t": "水|みず|vo.mizu は|gr.wa_topic ください|gr.n_kudasai 。", "why_zh": "要東西時接 {ja:を}，不是 {ja:は}。"}]},
  {"id": "dr.l03.z2j.004", "type": "zh_to_ja_choice", "lesson": "le.l03", "targets": ["gr.koko_soko"], "prompt_zh": "車站在哪裡？", "answer": "se.l03.029", "distractors": [{"t": "どこ|gr.koko_soko は|gr.wa_topic 駅|えき|vo.eki です|gr.desu か|gr.ka_q 。", "why_zh": "疑問詞 {ja:どこ} 不能接 {ja:は} 當主題。要把已知的「車站」當主題，疑問詞放在後面，說成 {ja:駅はどこですか|えきはどこですか}。"}, {"t": "駅|えき|vo.eki は|gr.wa_topic どこ|vo.doko です|gr.desu 。", "why_zh": "少了 {ja:か}，不是問句。"}]},
  {"id": "dr.l03.z2j.005", "type": "zh_to_ja_choice", "lesson": "le.l03", "targets": ["gr.no_pron_own"], "prompt_zh": "（對不熟的人說）這是我的。", "answer": "se.l03.044", "distractors": [{"t": "これ|vo.kore は|gr.wa_topic 私|わたし|vo.watashi です|gr.desu 。", "why_zh": "少了 {ja:の}，這句變成「這是我」。"}, {"t": "これ|vo.kore は|gr.wa_topic 私|わたし|vo.watashi の|gr.no_pron_own 。", "why_zh": "對不熟的人說話，句尾要有 {ja:です} 才有禮貌；少了 {ja:です} 是對熟人說的說法。"}]},
  {"id": "dr.l03.lsn.001", "type": "listen_meaning", "lesson": "le.l03", "targets": ["gr.numbers"], "sentence": "se.l03.077", "choices_zh": ["500 日圓。", "50 日圓。", "5000 日圓。", "150 日圓。"], "answer_index": 0},
  {"id": "dr.l03.lsn.002", "type": "listen_meaning", "lesson": "le.l03", "targets": ["gr.ikura"], "sentence": "se.l03.076", "choices_zh": ["不好意思，這個便當多少錢？", "不好意思，請給我這個便當。", "這個便當 500 日圓。"], "answer_index": 0},
  {"id": "dr.l03.lsn.003", "type": "listen_meaning", "lesson": "le.l03", "targets": ["gr.koko_soko"], "sentence": "se.l03.081", "choices_zh": ["不好意思，洗手間在哪裡？", "不好意思，車站在哪裡？", "這裡是洗手間嗎？"], "answer_index": 0},
