  {"id": "dr.l21.lsc.008", "type": "listen_meaning", "lesson": "le.l21", "targets": ["gr.plain_style"], "sentence": "se.c_weekend.02", "choices_zh": ["我去了很多地方。", "我哪裡都沒去。", "我哪裡都不想去。", "我和家人去了公園。"], "answer_index": 1},
