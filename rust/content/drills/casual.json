  {"id": "dr.l21.lsc.005", "type": "listen_meaning", "lesson": "le.l21", "targets": ["gr.un_uun"], "sentence": "se.c_whats_this.02", "choices_zh": ["嗯，是我的。", "不是，是我朋友的。", "不是，是老師的。", "不知道是誰的。"], "answer_index": 2},
  {"id": "dr.l21.lsc.006", "type": "listen_meaning", "lesson": "le.l21", "targets": ["gr.da_copula", "gr.kara_because"], "sentence": "se.c_whats_this.03", "choices_zh": ["不行啦，因為是老師的。", "可以啊，因為是我的。", "不行啦，因為很重。", "可以啊，不過要小心。"], "answer_index": 0},
