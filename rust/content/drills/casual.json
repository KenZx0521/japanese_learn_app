  {"id": "dr.l21.lsc.013", "type": "listen_meaning", "lesson": "le.l21", "targets": ["gr.plain_style", "gr.casual_q"], "sentence": "se.c_where_is.01", "choices_zh": ["欸，這附近有銀行嗎？", "欸，超商在車站裡面嗎？", "欸，這附近有超商嗎？", "欸，這附近有公園嗎？"], "answer_index": 2},
