{
  "schema": 1,
  "items": [
    {"id": "ka.cf.nu_me", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.nu", "ka.hira.me"], "diff_zh": "{ja:ぬ} 收尾有小圈，{ja:め} 收尾開放"},
    {"id": "ka.cf.ru_ro", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.ru", "ka.hira.ro"], "diff_zh": "{ja:る} 收尾有小圈，{ja:ろ} 收尾開放"},
    {"id": "ka.cf.wa_re_ne", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.wa", "ka.hira.re", "ka.hira.ne"], "diff_zh": "左邊相同，差在右半收筆：{ja:わ} 往內收住，{ja:れ} 上揚，{ja:ね} 打小圈"},
    {"id": "ka.cf.ha_ho", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.ha", "ka.hira.ho"], "diff_zh": "{ja:ほ} 比 {ja:は} 右上多一橫"},
    {"id": "ka.cf.sa_chi", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.sa", "ka.hira.chi"], "diff_zh": "下半的彎開口方向相反：{ja:さ} 開口朝右，{ja:ち} 開口朝左"},
    {"id": "ka.cf.ki_sa", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.ki", "ka.hira.sa"], "diff_zh": "{ja:き} 有兩橫，{ja:さ} 只有一橫"},
    {"id": "ka.cf.i_ri", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.i", "ka.hira.ri"], "diff_zh": "{ja:い} 左筆長、右筆短；{ja:り} 右筆長且往下拖"},
    {"id": "ka.cf.a_o", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.a", "ka.hira.o"], "diff_zh": "{ja:お} 右上多一點，{ja:あ} 沒有"},
    {"id": "ka.cf.ke_ha", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.ke", "ka.hira.ha"], "diff_zh": "左邊都是一豎；右邊 {ja:け} 是一橫一長豎，{ja:は} 的豎在下方打小圈"},
    {"id": "ka.cf.ko_ni", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.ko", "ka.hira.ni"], "diff_zh": "{ja:に} 左邊多一豎，{ja:こ} 只有上下兩畫"},
    {"id": "ka.cf.ta_na", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.ta", "ka.hira.na"], "diff_zh": "左半相近；{ja:た} 右邊是兩橫的 {ja:こ}，{ja:な} 右下打小結"},
    {"id": "ka.cf.ma_yo", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.ma", "ka.hira.yo"], "diff_zh": "{ja:ま} 有兩橫，{ja:よ} 只有一橫"},
    {"id": "ka.cf.u_tsu", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.u", "ka.hira.tsu"], "diff_zh": "{ja:う} 上方多一小畫，{ja:つ} 只有一筆弧線"},
    {"id": "ka.cf.shi_mo", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.shi", "ka.hira.mo"], "diff_zh": "{ja:し} 只有一筆，{ja:も} 多了兩橫"},
    {"id": "ka.cf.ra_chi", "lesson": "le.k10", "kind": "shape", "members": ["ka.hira.ra", "ka.hira.chi"], "diff_zh": "{ja:ら} 頂端是短短一點，{ja:ち} 頂端是一橫穿過一豎"},
    {"id": "ka.cf.kata_shi_tsu", "lesson": "le.kk02", "kind": "shape", "members": ["ka.kata.shi", "ka.kata.tsu"], "diff_zh": "{ja:シ} 兩個短點上下排列、筆畫偏橫，最後一筆由左下往右上；{ja:ツ} 兩個短點左右並排、筆畫偏直，最後一筆由上往左下"},
    {"id": "ka.cf.kata_so_n", "lesson": "le.kk05", "kind": "shape", "members": ["ka.kata.so", "ka.kata.n"], "diff_zh": "{ja:ソ} 兩筆都由上往下；{ja:ン} 第二筆由左下往右上"},
    {"id": "ka.cf.kata_no_me", "lesson": "le.kk04", "kind": "shape", "members": ["ka.kata.no", "ka.kata.me"], "diff_zh": "{ja:ノ} 只有一撇，{ja:メ} 多一筆交叉"},
    {"id": "ka.cf.kata_ku_ke_ta", "lesson": "le.kk02", "kind": "shape", "members": ["ka.kata.ku", "ka.kata.ke", "ka.kata.ta"], "diff_zh": "{ja:ク} 兩筆；{ja:ケ} 的橫筆往右突出（字源是「介」）；{ja:タ} 裡面多一點，像「夕」"},
    {"id": "ka.cf.kata_u_wa_fu", "lesson": "le.kk05", "kind": "shape", "members": ["ka.kata.u", "ka.kata.wa", "ka.kata.fu"], "diff_zh": "{ja:ウ} 上方有一點；{ja:ワ} 沒有上方的點，左邊有短豎；{ja:フ} 只有一筆橫折"},
    {"id": "ka.cf.kata_su_nu", "lesson": "le.kk03", "kind": "shape", "members": ["ka.kata.su", "ka.kata.nu"], "diff_zh": "{ja:ヌ} 像「又」，第二筆穿過第一筆；{ja:ス} 第二筆只從第一筆往右下撇出，不穿過"},
    {"id": "ka.cf.kata_ko_yu_ro", "lesson": "le.kk05", "kind": "shape", "members": ["ka.kata.ko", "ka.kata.yu", "ka.kata.ro"], "diff_zh": "{ja:コ} 左側開口；{ja:ユ} 下方那一橫較長，向右突出；{ja:ロ} 四邊封口，像「口」"},
    {"id": "ka.cf.kata_chi_te_na", "lesson": "le.kk03", "kind": "shape", "members": ["ka.kata.chi", "ka.kata.te", "ka.kata.na"], "diff_zh": "{ja:チ} 像「千」；{ja:テ} 上面兩橫；{ja:ナ} 只有一橫一撇"},
    {"id": "ka.cf.kata_a_ma", "lesson": "le.kk04", "kind": "shape", "members": ["ka.kata.a", "ka.kata.ma"], "diff_zh": "{ja:ア} 第二筆往左下撇；{ja:マ} 第二筆往右下點"},
    {"id": "ka.cf.kata_ra_fu", "lesson": "le.kk05", "kind": "shape", "members": ["ka.kata.ra", "ka.kata.fu"], "diff_zh": "{ja:ラ} 上面多一橫，{ja:フ} 只有一筆橫折"},
    {"id": "ka.cf.kata_wo_wa", "lesson": "le.kk05", "kind": "shape", "members": ["ka.kata.wo", "ka.kata.wa"], "diff_zh": "{ja:ヲ} 像 {ja:フ} 中間多一橫，左邊沒有短豎；{ja:ワ} 左邊有短豎，中間沒有橫"},
    {"id": "ka.cf.cross_he", "lesson": "le.kk03", "kind": "cross_script", "members": ["ka.hira.he", "ka.kata.he"], "diff_zh": "{ja:へ} 和 {ja:ヘ} 幾乎同形，平假名轉折較圓緩，片假名較銳利"},
    {"id": "ka.cf.cross_ri", "lesson": "le.kk05", "kind": "cross_script", "members": ["ka.hira.ri", "ka.kata.ri"], "diff_zh": "{ja:り} 右筆下拖帶弧，{ja:リ} 兩筆較直"},
    {"id": "ka.cf.cross_ka", "lesson": "le.kk01", "kind": "cross_script", "members": ["ka.hira.ka", "ka.kata.ka"], "diff_zh": "{ja:か} 右上多一點，{ja:カ} 沒有"},
    {"id": "ka.cf.cross_ki", "lesson": "le.kk01", "kind": "cross_script", "members": ["ka.hira.ki", "ka.kata.ki"], "diff_zh": "{ja:き} 下方多一道弧線，{ja:キ} 沒有"},
    {"id": "ka.cf.cross_se", "lesson": "le.kk02", "kind": "cross_script", "members": ["ka.hira.se", "ka.kata.se"], "diff_zh": "{ja:せ} 有三筆，{ja:セ} 只有兩筆"},
    {"id": "ka.cf.cross_mo", "lesson": "le.kk04", "kind": "cross_script", "members": ["ka.hira.mo", "ka.kata.mo"], "diff_zh": "{ja:も} 的直筆往上穿出兩橫，{ja:モ} 的直筆不往上穿出"},
    {"id": "ka.cf.cross_ya", "lesson": "le.kk04", "kind": "cross_script", "members": ["ka.hira.ya", "ka.kata.ya"], "diff_zh": "{ja:や} 三筆較圓潤，{ja:ヤ} 只有兩筆"},
    {"id": "ka.cf.ka_chikara", "lesson": "le.kk01", "kind": "kana_kanji", "members": ["ka.kata.ka"], "literals": [{"text": "力", "zh": "漢字「力」"}], "diff_zh": "{ja:カ} 是片假名，比漢字「力」小一點、線條更俐落"},
    {"id": "ka.cf.e_kou", "lesson": "le.kk01", "kind": "kana_kanji", "members": ["ka.kata.e"], "literals": [{"text": "工", "zh": "漢字「工」"}], "diff_zh": "{ja:エ} 和漢字「工」幾乎同形，要靠前後文判斷：混在片假名詞裡就是 {ja:エ}"},
    {"id": "ka.cf.ta_yuu", "lesson": "le.kk02", "kind": "kana_kanji", "members": ["ka.kata.ta"], "literals": [{"text": "夕", "zh": "漢字「夕」"}], "diff_zh": "{ja:タ} 和漢字「夕」幾乎同形，要靠前後文判斷"},
    {"id": "ka.cf.to_boku", "lesson": "le.kk02", "kind": "kana_kanji", "members": ["ka.kata.to"], "literals": [{"text": "卜", "zh": "漢字「卜」"}], "diff_zh": "{ja:ト} 和漢字「卜」幾乎同形，要靠前後文判斷"},
    {"id": "ka.cf.ni_ni", "lesson": "le.kk03", "kind": "kana_kanji", "members": ["ka.kata.ni"], "literals": [{"text": "二", "zh": "漢字「二」"}], "diff_zh": "{ja:ニ} 和漢字「二」幾乎同形，要靠前後文判斷：混在片假名詞裡就是 {ja:ニ}"},
    {"id": "ka.cf.ha_hachi", "lesson": "le.kk03", "kind": "kana_kanji", "members": ["ka.kata.ha"], "literals": [{"text": "八", "zh": "漢字「八」"}], "diff_zh": "{ja:ハ} 和漢字「八」幾乎同形，要靠前後文判斷"},
    {"id": "ka.cf.mi_san", "lesson": "le.kk04", "kind": "kana_kanji", "members": ["ka.kata.mi"], "literals": [{"text": "三", "zh": "漢字「三」"}], "diff_zh": "{ja:ミ} 三筆都斜斜往右下；漢字「三」是三條水平橫線"},
    {"id": "ka.cf.ro_kuchi", "lesson": "le.kk05", "kind": "kana_kanji", "members": ["ka.kata.ro"], "literals": [{"text": "口", "zh": "漢字「口」"}], "diff_zh": "{ja:ロ} 和漢字「口」幾乎同形，片假名通常寫得小一點"},
    {"id": "ka.cf.ka_ga", "lesson": "le.k11", "kind": "listen", "members": ["ka.hira.ka", "ka.hira.ga"], "diff_zh": "{ja:か} 聲帶不振動，{ja:が} 聲帶振動，差別不在送氣多寡"},
    {"id": "ka.cf.ta_da", "lesson": "le.k12", "kind": "listen", "members": ["ka.hira.ta", "ka.hira.da"], "diff_zh": "{ja:た} 聲帶不振動，{ja:だ} 聲帶振動，差別不在送氣多寡"},
    {"id": "ka.cf.ha_ba_pa", "lesson": "le.k13", "kind": "listen", "members": ["ka.hira.ha", "ka.hira.ba", "ka.hira.pa"], "diff_zh": "{ja:は} 是從喉嚨吐氣的清音；{ja:ば} 雙唇閉合、聲帶振動；{ja:ぱ} 雙唇閉合、聲帶不振動"},
    {"id": "ka.cf.shi_chi", "lesson": "le.k04", "kind": "listen", "members": ["ka.hira.shi", "ka.hira.chi"], "diff_zh": "{ja:し} 是持續的摩擦音；{ja:ち} 舌面先堵住再放開"},
    {"id": "ka.cf.su_tsu", "lesson": "le.k04", "kind": "listen", "members": ["ka.hira.su", "ka.hira.tsu"], "diff_zh": "{ja:す} 是持續的摩擦音；{ja:つ} 舌尖先頂住上齒背再迸開"},
    {"id": "ka.cf.shu_su", "lesson": "le.k14", "kind": "listen", "members": ["ka.hira.shu", "ka.hira.su"], "diff_zh": "{ja:しゅ} 舌面抬高靠近上顎；{ja:す} 舌尖靠近上齒背"},
    {"id": "ka.cf.chu_tsu", "lesson": "le.k14", "kind": "listen", "members": ["ka.hira.chu", "ka.hira.tsu"], "diff_zh": "{ja:ちゅ} 舌面抵住上顎前端；{ja:つ} 舌尖頂住上齒背"},
    {"id": "ka.cf.ja_za", "lesson": "le.k15", "kind": "listen", "members": ["ka.hira.ja", "ka.hira.za"], "diff_zh": "{ja:じゃ} 舌面抬高靠近上顎；{ja:ざ} 舌尖靠近上齒背"},
    {"id": "ka.cf.obasan_obaasan", "lesson": "le.k17", "kind": "listen", "members": [], "literals": [{"text": "おばさん", "zh": "阿姨"}, {"text": "おばあさん", "zh": "奶奶"}], "diff_zh": "長音多一拍，意思完全不同"},
    {"id": "ka.cf.ojisan_ojiisan", "lesson": "le.k17", "kind": "listen", "members": [], "literals": [{"text": "おじさん", "zh": "叔叔"}, {"text": "おじいさん", "zh": "爺爺"}], "diff_zh": "長音多一拍，意思完全不同"},
    {"id": "ka.cf.kite_kitte", "lesson": "le.k16", "kind": "listen", "members": [], "literals": [{"text": "きて", "zh": "來（動詞的變化形）"}, {"text": "きって", "zh": "郵票"}], "diff_zh": "促音多停一拍，意思完全不同"},
    {"id": "ka.cf.biru_biiru", "lesson": "le.kk07", "kind": "listen", "members": [], "literals": [{"text": "ビル", "zh": "大樓"}, {"text": "ビール", "zh": "啤酒"}], "diff_zh": "長音多一拍，意思完全不同"}
  ]
}
