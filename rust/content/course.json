  "lessons": [
    {"id": "le.k01", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:あ}行", "can_do_zh": "能讀出 {ja:あいうえお} 五個母音", "dialogue": null},
    {"id": "le.k02", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:か}行", "can_do_zh": "能讀出 {ja:かきくけこ}，發音時不必用力送氣", "dialogue": null},
    {"id": "le.k03", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:さ}行", "can_do_zh": "能讀出 {ja:さしすせそ}，念準 {ja:し} 的音", "dialogue": null},
    {"id": "le.k04", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:た}行", "can_do_zh": "能讀出 {ja:たちつてと}，念準 {ja:ち} 和 {ja:つ} 的音", "dialogue": null},
    {"id": "le.k05", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:な}行", "can_do_zh": "能讀出 {ja:なにぬねの}", "dialogue": null},
    {"id": "le.k06", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:は}行", "can_do_zh": "能讀出 {ja:はひふへほ}，念準 {ja:ふ} 的音", "dialogue": null},
    {"id": "le.k07", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:ま}行", "can_do_zh": "能讀出 {ja:まみむめも}", "dialogue": null},
    {"id": "le.k08", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:や}行與 {ja:わ・を・ん}", "can_do_zh": "能讀出 {ja:やゆよ} 和 {ja:わをん}，知道 {ja:ん} 自己佔一拍", "dialogue": null},
    {"id": "le.k09", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:ら}行", "can_do_zh": "能讀出 {ja:らりるれろ}，發出輕輕彈舌的音", "dialogue": null},
    {"id": "le.k10", "stage": "st.s0", "content_stage": "p0a", "title_zh": "平假名總複習", "can_do_zh": "能分清長得像的平假名，例如 {ja:ぬ} 和 {ja:め}、{ja:わ} 和 {ja:ね}", "dialogue": null},
    {"id": "le.k11", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:が}行、{ja:ざ}行", "can_do_zh": "能讀出 {ja:が} 行和 {ja:ざ} 行，開始聽出清音與濁音的差別", "dialogue": null},
    {"id": "le.k12", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:だ}行、{ja:ば}行", "can_do_zh": "能讀出 {ja:だ} 行和 {ja:ば} 行，知道 {ja:ぢ}、{ja:づ} 和 {ja:じ}、{ja:ず} 同音", "dialogue": null},
    {"id": "le.k13", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:ぱ}行", "can_do_zh": "能讀出 {ja:ぱ} 行，並分清 {ja:ば} 和 {ja:ぱ}", "dialogue": null},
    {"id": "le.k14", "stage": "st.s0", "content_stage": "p0a", "title_zh": "拗音（清音 7 行）", "can_do_zh": "能把 {ja:きゃ}、{ja:しゅ}、{ja:ちょ} 這類拗音念成一拍", "dialogue": null},
    {"id": "le.k15", "stage": "st.s0", "content_stage": "p0a", "title_zh": "拗音（濁音、半濁音 4 行）", "can_do_zh": "能讀出 {ja:ぎゃ}、{ja:じゃ}、{ja:びゃ}、{ja:ぴゃ} 四行拗音", "dialogue": null},
    {"id": "le.k16", "stage": "st.s0", "content_stage": "p0a", "title_zh": "促音 {ja:っ}", "can_do_zh": "能念出促音的停頓，聽出 {ja:きて} 和 {ja:きって} 的差別", "dialogue": null},
    {"id": "le.k17", "stage": "st.s0", "content_stage": "p0a", "title_zh": "長音", "can_do_zh": "能把長音念滿兩拍，聽出 {ja:おばさん} 和 {ja:おばあさん} 的差別", "dialogue": null},
    {"id": "le.k18", "stage": "st.s0", "content_stage": "p0a", "title_zh": "助詞 {ja:は・へ・を}、{ja:ん} 的音值、母音無聲化", "can_do_zh": "能把助詞 {ja:は}、{ja:へ}、{ja:を} 讀成 wa、e、o，並念出自然的 {ja:です}", "dialogue": null},
    {"id": "le.k19", "stage": "st.s0", "content_stage": "p0a", "title_zh": "音調入門與平假名畢業考", "can_do_zh": "知道日語音調是高低變化而不是四聲，並完成平假名畢業考", "dialogue": null},
    {"id": "le.kk01", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:ア}行、{ja:カ}行", "can_do_zh": "能讀出 {ja:アイウエオ} 和 {ja:カキクケコ}", "dialogue": null},
    {"id": "le.kk02", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:サ}行、{ja:タ}行", "can_do_zh": "能讀出 {ja:サ} 行和 {ja:タ} 行，並分清 {ja:シ} 和 {ja:ツ}", "dialogue": null},
    {"id": "le.kk03", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:ナ}行、{ja:ハ}行", "can_do_zh": "能讀出 {ja:ナ} 行和 {ja:ハ} 行", "dialogue": null},
    {"id": "le.kk04", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:マ}行、{ja:ヤ}行", "can_do_zh": "能讀出 {ja:マ} 行和 {ja:ヤ} 行", "dialogue": null},
    {"id": "le.kk05", "stage": "st.s0", "content_stage": "p0a", "title_zh": "{ja:ラ}行、{ja:ワ・ヲ・ン}", "can_do_zh": "能讀出 {ja:ラ} 行和 {ja:ワヲン}，並分清 {ja:ソ} 和 {ja:ン}", "dialogue": null},
    {"id": "le.kk06", "stage": "st.s0", "content_stage": "p0a", "title_zh": "片假名濁音、半濁音", "can_do_zh": "能讀出片假名的濁音和半濁音，規則和平假名相同", "dialogue": null},
    {"id": "le.kk07", "stage": "st.s0", "content_stage": "p0a", "title_zh": "片假名拗音、{ja:ッ}、{ja:ー}", "can_do_zh": "能讀出片假名的拗音、促音 {ja:ッ} 和長音符號 {ja:ー}", "dialogue": null},
    {"id": "le.kk08", "stage": "st.s0", "content_stage": "p0a", "title_zh": "擴充拼法與外來語規則", "can_do_zh": "能讀出 {ja:ティ}、{ja:ファ} 這類外來語拼法，並完成片假名畢業考", "dialogue": null},
    {"id": "le.l01", "stage": "st.s1", "content_stage": "p0a", "title_zh": "初次見面", "can_do_zh": "能用 {ja:〜です} 說出姓名與身分，也能問對方是什麼身分", "dialogue": "di.self_intro"},
    {"id": "le.l02", "stage": "st.s1", "content_stage": "p0a", "title_zh": "這是什麼", "can_do_zh": "能指著身邊的東西問「這是什麼」，並回答是或不是", "dialogue": "di.whats_this"},
    {"id": "le.l03", "stage": "st.s1", "content_stage": "p0a", "title_zh": "多少錢", "can_do_zh": "能在便利商店問價錢、聽懂金額，並說「請給我這個」", "dialogue": "di.konbini"},
    {"id": "le.l04", "stage": "st.s1", "content_stage": "p0a", "title_zh": "幾點", "can_do_zh": "能說出時間、星期和日期，並詢問店家的營業時間", "dialogue": "di.opening_hours"},
    {"id": "le.l05", "stage": "st.s1", "content_stage": "p0a", "title_zh": "每天做的事", "can_do_zh": "能說出每天幾點、在哪裡、做什麼", "dialogue": "di.daily_routine"},
    {"id": "le.l06", "stage": "st.s1", "content_stage": "p0a", "title_zh": "去哪裡", "can_do_zh": "能說出週末去了哪裡、怎麼去、和誰去", "dialogue": "di.weekend"},
    {"id": "le.l07", "stage": "st.s1", "content_stage": "p0a", "title_zh": "一起去吧", "can_do_zh": "能邀請別人一起做事，也能回應別人的邀請", "dialogue": "di.invite_movie"},
    {"id": "le.l08", "stage": "st.s1", "content_stage": "p0", "title_zh": "有沒有、在哪裡", "can_do_zh": "能說明東西在哪裡，以及某處有沒有某樣東西", "dialogue": "di.where_is"},
    {"id": "le.l09", "stage": "st.s1", "content_stage": "p0", "title_zh": "形容事物", "can_do_zh": "能用形容詞描述人事物，介紹自己住的地方", "dialogue": "di.my_town"},
    {"id": "le.l10", "stage": "st.s1", "content_stage": "p0", "title_zh": "喜歡與擅長", "can_do_zh": "能說出自己喜歡什麼、擅長什麼，和別人聊興趣", "dialogue": "di.hobbies"},
    {"id": "le.l11", "stage": "st.s1", "content_stage": "p0", "title_zh": "數量與點餐", "can_do_zh": "能數東西、說出數量，並在餐廳點餐", "dialogue": "di.restaurant"},
    {"id": "le.l12", "stage": "st.s1", "content_stage": "p0", "title_zh": "想要、想做", "can_do_zh": "能說出想要的東西和想做的事，並說明理由", "dialogue": "di.travel_wish"},
    {"id": "le.l13", "stage": "st.s1", "content_stage": "p0", "title_zh": "比較與選擇", "can_do_zh": "能比較兩樣東西，並從幾個選項中選出最好的", "dialogue": "di.choose_gift"},
    {"id": "le.l14", "stage": "st.s1", "content_stage": "p0", "title_zh": "動詞三類", "can_do_zh": "能分辨動詞的三種類型，並和朋友約好碰面的地點", "dialogue": "di.meet_friend"},
    {"id": "le.l15", "stage": "st.s2", "content_stage": "p0", "title_zh": "請做", "can_do_zh": "能用 {ja:〜てください} 拜託別人，並開口問路", "dialogue": "di.ask_way"},
    {"id": "le.l16", "stage": "st.s2", "content_stage": "p0", "title_zh": "正在做、狀態", "can_do_zh": "能說出正在做的事和目前的狀態，並在電話中說明自己在哪裡", "dialogue": "di.phone_where"},
    {"id": "le.l17", "stage": "st.s2", "content_stage": "p0", "title_zh": "接著做", "can_do_zh": "能依序說明一連串的動作，並在車站買票", "dialogue": "di.station_ticket"},
    {"id": "le.l18", "stage": "st.s2", "content_stage": "p0", "title_zh": "否定形", "can_do_zh": "能用 {ja:〜ないでください} 請別人不要做某事，並看懂簡單的規定", "dialogue": "di.library_rules"},
    {"id": "le.l19", "stage": "st.s2", "content_stage": "p0", "title_zh": "可以、不行", "can_do_zh": "能詢問可不可以做某事，也能說明什麼不能做", "dialogue": "di.museum_rules"},
    {"id": "le.l20", "stage": "st.s2", "content_stage": "p0", "title_zh": "經驗與列舉", "can_do_zh": "能說出做過的事，並舉例描述旅行經驗", "dialogue": "di.travel_story"},
    {"id": "le.l21", "stage": "st.s2", "content_stage": "p0", "title_zh": "常體", "can_do_zh": "能看懂朋友間的常體句子，並用常體簡單問答", "dialogue": "di.friends_casual"},
    {"id": "le.l22", "stage": "st.s2", "content_stage": "p0", "title_zh": "我覺得、他說", "can_do_zh": "能說出自己的想法，並轉述別人說的話", "dialogue": "di.opinion_movie"},
    {"id": "le.l23", "stage": "st.s2", "content_stage": "p0", "title_zh": "名詞修飾", "can_do_zh": "能用一整句話修飾名詞，描述遺失的東西", "dialogue": "di.lost_item"},
    {"id": "le.l24", "stage": "st.s2", "content_stage": "p0", "title_zh": "會做", "can_do_zh": "能說出自己會做什麼，並應付打工面試的問答", "dialogue": "di.part_time"},
    {"id": "le.l25", "stage": "st.s2", "content_stage": "p0", "title_zh": "必須、建議", "can_do_zh": "能說出必須做的事，給別人建議，並在診所描述狀況", "dialogue": "di.clinic"},
    {"id": "le.l26", "stage": "st.s2", "content_stage": "p0", "title_zh": "時間子句", "can_do_zh": "能說明事情發生的先後順序，討論旅行計畫", "dialogue": "di.trip_plan"},
    {"id": "le.l27", "stage": "st.s2", "content_stage": "p0", "title_zh": "變化", "can_do_zh": "能說明事物的變化，以及事情做完了沒", "dialogue": "di.getting_better"},
    {"id": "le.l28", "stage": "st.s2", "content_stage": "p0", "title_zh": "給與收", "can_do_zh": "能正確說出誰給誰東西、誰從誰那裡收到東西", "dialogue": "di.birthday"},
    {"id": "le.l29", "stage": "st.s2", "content_stage": "p0", "title_zh": "說明語氣", "can_do_zh": "能用 {ja:〜んです} 說明原因，例如解釋為什麼遲到", "dialogue": "di.excuse_late"},
    {"id": "le.l30", "stage": "st.s2", "content_stage": "p0", "title_zh": "參考 N5 總複習", "can_do_zh": "能綜合運用前面學過的句型，完成一整天的對話", "dialogue": "di.n5_day"},
    {"id": "le.l31", "stage": "st.s3", "content_stage": "full", "title_zh": "能力", "can_do_zh": "能說出自己會說、會做什麼，並把問題放進句子裡轉述", "dialogue": "di.can_you_speak"},
    {"id": "le.l32", "stage": "st.s3", "content_stage": "full", "title_zh": "打算", "can_do_zh": "能說出自己的打算和預定行程", "dialogue": "di.new_year_plans"},
    {"id": "le.l33", "stage": "st.s3", "content_stage": "full", "title_zh": "如果（一）", "can_do_zh": "能用 {ja:〜たら} 談假設的情況，並徵求或提供建議", "dialogue": "di.if_rain"},
    {"id": "le.l34", "stage": "st.s3", "content_stage": "full", "title_zh": "如果（二）", "can_do_zh": "能說明操作步驟與條件，例如機器怎麼用", "dialogue": "di.how_to_machine"},
    {"id": "le.l35", "stage": "st.s3", "content_stage": "full", "title_zh": "完成與準備", "can_do_zh": "能說出不小心做了什麼、事先準備了什麼、試著做了什麼", "dialogue": "di.forgot_wallet"},
    {"id": "le.l36", "stage": "st.s3", "content_stage": "full", "title_zh": "狀態與方向", "can_do_zh": "能分辨自動詞和他動詞，描述房間裡的狀態，並用 {ja:〜ていく}／{ja:〜てくる} 說明東西帶去帶來、動作朝哪個方向", "dialogue": "di.hotel_room"},
    {"id": "le.l37", "stage": "st.s3", "content_stage": "full", "title_zh": "幫忙", "can_do_zh": "能請別人幫忙，也能說出別人為自己做了什麼", "dialogue": "di.moving_help"},
    {"id": "le.l38", "stage": "st.s3", "content_stage": "full", "title_zh": "看起來、聽說", "can_do_zh": "能說出事物看起來如何、聽說了什麼，並表達推測", "dialogue": "di.looks_delicious"},
    {"id": "le.l39", "stage": "st.s3", "content_stage": "full", "title_zh": "好像", "can_do_zh": "能用「好像」表達自己的判斷，並轉述傳聞", "dialogue": "di.rumor"},
    {"id": "le.l40", "stage": "st.s3", "content_stage": "full", "title_zh": "雖然、即使", "can_do_zh": "能表達「雖然」「即使」，並列舉理由抱怨或說明", "dialogue": "di.complain_friend"},
    {"id": "le.l41", "stage": "st.s3", "content_stage": "full", "title_zh": "被", "can_do_zh": "能用被動句描述倒楣的經歷和社會上的事實", "dialogue": "di.bad_day"},
    {"id": "le.l42", "stage": "st.s3", "content_stage": "full", "title_zh": "叫人做", "can_do_zh": "能說出讓別人做什麼，也能表達「請讓我做」", "dialogue": "di.parents_kids"},
    {"id": "le.l43", "stage": "st.s3", "content_stage": "full", "title_zh": "命令與禁止", "can_do_zh": "能聽懂命令和禁止的說法，知道什麼場合才能用", "dialogue": "di.sports_coach"},
    {"id": "le.l44", "stage": "st.s3", "content_stage": "full", "title_zh": "複合動詞", "can_do_zh": "能說明動作的開始、持續和結束，以及做起來容不容易", "dialogue": "di.cooking_class"},
    {"id": "le.l45", "stage": "st.s3", "content_stage": "full", "title_zh": "變化與決定", "can_do_zh": "能說明習慣上的變化，以及自己或公司做的決定", "dialogue": "di.new_habit"},
    {"id": "le.l46", "stage": "st.s3", "content_stage": "full", "title_zh": "時間的細節", "can_do_zh": "能精確說出事情剛發生、正要發生或持續多久", "dialogue": "di.just_arrived"},
    {"id": "le.l47", "stage": "st.s3", "content_stage": "full", "title_zh": "敬語（一）尊敬", "can_do_zh": "能聽懂基本的尊敬語，第一次拜訪時應對得體", "dialogue": "di.first_visit"},
    {"id": "le.l48", "stage": "st.s3", "content_stage": "full", "title_zh": "敬語（二）謙讓與總複習", "can_do_zh": "能用基本的謙讓語打商務電話，並完成主線總複習", "dialogue": "di.business_call"}
  ]
}
